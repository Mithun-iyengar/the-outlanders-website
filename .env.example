# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# Database Connection (Supabase PostgreSQL / Standard PostgreSQL)
DATABASE_URL=postgresql://postgres:your_db_password@db.your_project.supabase.co:5432/postgres

# Supabase Credentials (Optional if using direct PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret Key for Admin Authentication
JWT_SECRET=outlanders_secret_jwt_key_2026_change_in_production

# Initial Admin Credentials (used during migration/seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=outlanders2026

# Allowed Frontend URLs for CORS (comma separated)
FRONTEND_URL=http://localhost:8000,http://127.0.0.1:8000,https://the-outlanders-website.vercel.app
